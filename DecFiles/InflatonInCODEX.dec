Alias      MyScalar    Inflat0
Alias MyK*0      K*0
Alias Myanti-K*0 anti-K*0

ChargeConj MyScalar  MyScalar
ChargeConj MyK*0 Myanti-K*0

#
Decay B0sig
  1.000         MyK*0  MyScalar                 PHSP;
Enddecay
CDecay B-sig

#
Decay MyScalar
  1.000         mu+      mu-                    PHSP; 
Enddecay
#
Decay MyK*0
  1.000    K+         pi-         VSS;
Enddecay
CDecay Myanti-K*0

End
